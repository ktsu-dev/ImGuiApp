<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <!-- ktsu.ImGui.NodeEditor also references Polyfill and now gets InternalsVisibleTo below, so
         without this its own copy of the Polyfill extension methods collides with this assembly's,
         making every such call ambiguous. EmbeddedAttribute keeps this assembly's polyfilled
         members out of what a friend assembly's overload resolution sees. -->
    <PolyUseEmbeddedAttribute>true</PolyUseEmbeddedAttribute>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ktsu.ImGui.Widgets.Tests" />
    <InternalsVisibleTo Include="ktsu.ImGui.NodeEditor" />
    <InternalsVisibleTo Include="ktsu.ImGui.Widgets.UITests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets" />
    <PackageReference Include="Hexa.NET.ImGui.Widgets.Extras" />
    <PackageReference Include="Hexa.NET.Math" />
    <PackageReference Include="ktsu.Extensions" />
    <PackageReference Include="ktsu.Keybinding" />
    <PackageReference Include="ktsu.ScopedAction" />
    <PackageReference Include="ktsu.Semantics.Color" />
    <PackageReference Include="ktsu.Semantics.Paths" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="ktsu.TextFilter" />
    <ProjectReference Include="..\ImGui.Color\ImGui.Color.csproj" />
    <ProjectReference Include="..\ImGui.Probes\ImGui.Probes.csproj" />
    <ProjectReference Include="..\ImGui.Styler\ImGui.Styler.csproj" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
