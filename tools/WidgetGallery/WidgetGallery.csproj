<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.ConsoleApp" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>ktsu.ImGui.WidgetGallery</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <!-- A developer tool that regenerates README images, not something anyone consumes. -->
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ImGui.App.Testing\ImGui.App.Testing.csproj" />
    <ProjectReference Include="..\..\ImGui.Widgets\ImGui.Widgets.csproj" />
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="ktsu.Semantics.Color" />
    <PackageReference Include="ktsu.Semantics.Paths" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>
</Project>
