<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <!-- net10.0 only, deliberately. This is test infrastructure consumed by test projects,
         which target the latest runtime by convention. ImGui.App grants this assembly
         InternalsVisibleTo, for ImGuiContextHost (#313), and marks its Polyfill members embedded
         so they do not collide with this assembly's own copy. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>ktsu.ImGui.App.Testing</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" />
    <!-- Used directly: the harness pumps ImGuiApp.Invoker every frame so work marshalled from a
         worker thread lands rather than being lost. -->
    <PackageReference Include="ktsu.Invoker" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImGui.App\ImGui.App.csproj" />
    <ProjectReference Include="..\ImGui.Probes\ImGui.Probes.csproj" />
  </ItemGroup>

</Project>
