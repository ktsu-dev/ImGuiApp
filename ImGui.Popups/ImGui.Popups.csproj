<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <!-- Trim- and AOT-clean, so an iOS app (always trimmed and AOT compiled) can take it (#671).
         Warnings are errors here, so new reflection the trimmer can't follow fails the build. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ktsu.ImGui.Popups.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImGui.Probes\ImGui.Probes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One text field for every library in the suite (#553). Linked rather than referenced, since
         this package does not depend on ktsu.ImGui.Widgets. -->
    <Compile Include="..\ImGui.Widgets\ResizableInputText.cs" Link="ResizableInputText.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.ImGui" />
    <PackageReference Include="ktsu.Extensions" />
    <PackageReference Include="ktsu.CaseConverter" />
    <PackageReference Include="ktsu.ScopedAction" />
    <PackageReference Include="ktsu.TextFilter" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="ktsu.Semantics.Paths" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
